<!DOCTYPE html>
<html lang="en">
    <head>
        <!--Standard setup and references-->
        <link rel="stylesheet" href="/styles.css">
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Isaac's Crazy Blog</title>
    </head>
    <body>

        <h1>Isaac's Crazy Blog</h1>
        <p>Welcome to my blog!</p>
        <p>Please be respectful of others.</p>
        <p>Number of posts: <%= posts.length %></p>
        <% if (user) { %>
            <p>Signed in as <%= user.name %></p>
            <form action="/logout" method="POST">
                <button type="submit">Log Out</button>
            </form>
        <% } else { %>
            <p><a href="/signin">Sign In</a> | <a href="/signup">Sign Up</a></p>
        <% } %>

       <% if (user) { %>
    <h2>Create a New Post</h2>

    <form action="/posts" method="POST">
        <label for="title">Blog Title:</label>
        <input type="text" id="title" name="title" required>

        <br><br>

        <label for="content">Blog Content:</label>
        <br>
        <textarea id="content" name="content" rows="8" cols="50" required></textarea>

            <br><br>

            <button type="submit">Create Post</button>
        </form>
    <% } else { %>
        <p>Sign in to create a blog post.</p>
    <% } %>


        <h2>Blog posts</h2>
        <% posts.forEach(post => { %>

            <article>
                <h3><%= post.title %></h3>

                <p>by <%= post.creator_name %></p>
                <p>Posted on <%= post.date_created %></p>
                <p><%= post.body %></p>

                <!--Allows the post to be edited identified by its id-->
                <a href="/posts/<%= post.blog_id %>/edit">Edit</a>

                <!--Allows the action of deletion through the ID-->
                <form action="/posts/<%= post.blog_id %>/delete" method="POST">
                    <button type="submit">Delete</button>
                </form>
            </article>
        
        <% }) %>

    </body>
</html>